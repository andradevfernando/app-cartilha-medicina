        <div class="footer-bar section-wrap">
            <div class="partner-logos" aria-label="Instituições parceiras">
                <img src="images/logo-ufmt.png" alt="UFMT" />
                <img src="images/logo-pineduts.jpg" alt="PINEDUTS" />
            </div>
            <span>◎ @@geohelmintiases &nbsp; ✣ @@pinedutsufmt</span>
        </div>
    </footer>
    <a id="back-to-top-button" class="floating-back-to-top" href="#inicio" aria-label="Voltar ao início">↑</a>
